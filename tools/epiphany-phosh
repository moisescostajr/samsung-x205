#!/bin/sh
# Epiphany/WebKit crashes on this SPRD 4.14 stack: no USER_NS (bwrap sandbox),
# no render node (GBM/dmabuf), and GTK4's GL renderer SIGSEGVs. Force cairo
# + software GL and skip the sandbox. Unset compositor shims so they are not
# inherited by WebKit helper processes.
unset LD_PRELOAD
export GSK_RENDERER=cairo
export GDK_BACKEND=wayland
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
exec /usr/bin/epiphany-browser "$@"
