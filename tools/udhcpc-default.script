#!/bin/busybox sh
# Minimal udhcpc hook: the Debian image has no /usr/share/udhcpc/default.script.
[ -z "$1" ] && exit 1
[ -z "$interface" ] && exit 1
case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null
        ;;
    bound|renew)
        ip addr flush dev "$interface" 2>/dev/null
        ip addr add "$ip/$mask" dev "$interface"
        [ -n "$router" ] && ip route replace default via "$router" dev "$interface"
        : > /etc/resolv.conf
        for d in $dns; do
            echo "nameserver $d" >> /etc/resolv.conf
        done
        ;;
esac
exit 0
